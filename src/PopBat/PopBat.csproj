<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PopBat</AssemblyName>
    <Version>0.4.8</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © 2026 DennisL2045</Copyright>
    <Description>Local-only standard Bluetooth and HID battery monitor with vendor fallbacks</Description>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><AssemblyMetadata Include="SelfContained" Value="$(SelfContained)" /></ItemGroup>
  <!-- Pin only .NET packs; Windows SDK projections have an independent version. -->
  <Target Name="PinBundledRuntimePatch" BeforeTargets="ProcessFrameworkReferences" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <FrameworkReference>
        <RuntimeFrameworkVersion Condition="'%(FrameworkReference.Identity)' == 'Microsoft.NETCore.App' Or '%(FrameworkReference.Identity)' == 'Microsoft.WindowsDesktop.App'">8.0.32</RuntimeFrameworkVersion>
      </FrameworkReference>
      <KnownAppHostPack>
        <AppHostPackVersion Condition="'%(KnownAppHostPack.TargetFramework)' == 'net8.0'">8.0.32</AppHostPackVersion>
      </KnownAppHostPack>
      <KnownILLinkPack>
        <ILLinkPackVersion Condition="'%(KnownILLinkPack.TargetFramework)' == 'net8.0'">8.0.32</ILLinkPackVersion>
      </KnownILLinkPack>
    </ItemGroup>
  </Target>
</Project>
