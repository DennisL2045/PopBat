<Window x:Class="PopBat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PopBat — 無線裝置電量" Width="760" Height="800" MinWidth="680" MinHeight="660" WindowStartupLocation="CenterScreen"
 Background="#101720" Foreground="#F1F5F9" FontFamily="Segoe UI, Microsoft JhengHei UI" WindowStyle="None" ResizeMode="CanMinimize">
 <Border BorderBrush="#344150" BorderThickness="1" CornerRadius="14"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="24,0" MouseLeftButtonDown="Header_Drag">
   <TextBlock Text="PopBat · WIRELESS POWER" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="—" Padding="12,6" Click="Hide_Click" ToolTip="最小化至通知區"/>
    <Button Content="×" FontSize="20" Padding="12,4" Click="Hide_Click" ToolTip="隱藏視窗，保持常駐"/>
   </StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,12,28,24">
   <TextBlock Text="你的無線裝置電量" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="啟動時讀取一次 · 手動更新取得新電量" Foreground="#92A1B2" Margin="0,8,0,8" FontSize="13"/>
   <TextBlock x:Name="LogitechSummary" Text="正在讀取裝置名稱與電量…" Foreground="#92A1B2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
   <ItemsControl x:Name="DeviceCards"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="#19232F" BorderBrush="#314052" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,12"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding Data.Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Data.Connection}" Foreground="#92A1B2" FontSize="12" Margin="0,5,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="#253543" CornerRadius="14" Padding="12,7" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Data.StateText}" Foreground="#B8F46B" FontSize="12"/></Border>
     </Grid>
     <TextBlock Text="{Binding Data.BatteryText}" FontSize="36" FontWeight="Light" TextWrapping="Wrap" Margin="0,12,0,8"/>
     <ProgressBar Height="8" Maximum="100" Value="{Binding Data.BatteryValue}" Background="#324151" Foreground="{Binding Data.BatteryBrush}" BorderThickness="0"/>
     <TextBlock Text="{Binding Data.Detail}" Foreground="#B2C0CF" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
     <Border BorderBrush="#314052" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="充電狀態" Foreground="#8797A9" FontSize="11"/><TextBlock Text="{Binding Data.ChargingText}" Margin="0,7,0,0" FontSize="14"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="預估剩餘時間" Foreground="#8797A9" FontSize="11"/><TextBlock Text="{Binding Data.EstimateText}" Margin="0,7,0,0" FontSize="14" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="最後成功更新" Foreground="#8797A9" FontSize="11"/><TextBlock Text="{Binding Data.LastSuccessText}" Margin="0,7,0,0" FontSize="14"/></StackPanel>
     </Grid></Border>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Grid Margin="0,4,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="RefreshButton" Content="立即更新" Background="#B8F46B" Foreground="#172015" Click="Refresh_Click"/>
    <Button x:Name="CancelButton" Grid.Column="1" Content="取消更新" IsEnabled="False" Margin="10,0,0,0" Click="Cancel_Click"/>
    <TextBlock x:Name="CheckText" Grid.Column="2" Text="啟動時讀取一次，之後手動更新" FontSize="11" Foreground="#8797A9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
   <Border x:Name="PreferencesPanel" Background="#17212B" CornerRadius="12" Padding="18,16"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <CheckBox x:Name="NotifyCheck" Content="啟用低電量通知" IsChecked="False" Foreground="#D8E1EA" FontSize="12" VerticalAlignment="Center" Checked="Preferences_Changed" Unchecked="Preferences_Changed"/>
     <Button Grid.Column="1" Content="清除紀錄" Padding="12,6" FontSize="11" Click="Clear_Click" Margin="10,0,0,0"/>
   </Grid></Border>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="常駐時不自動查詢。顯示上次讀取結果；選「結束程式」退出。" FontSize="11" Foreground="#8797A9" TextWrapping="Wrap" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Content="結束程式" Background="Transparent" Foreground="#A6B4C3" Padding="10,6" FontSize="12" Click="Exit_Click"/>
   </Grid>
  </StackPanel></ScrollViewer>
 </Grid></Border>
</Window>
